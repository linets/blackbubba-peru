{%- assign content_block = block -%}
{%- if content_block == blank -%}
  {%- assign content_block = first_content_block -%}
{%- endif -%}

{%- if content_block != blank -%}
  {%- if content_block.type == 'announcement' -%}
    {%- liquid
      assign announcement_classes = 'announcement-bar__announcement'
      if single_view
        assign announcement_classes = 'announcement-bar'
        if show_one_announcement
          assign announcement_classes = announcement_classes | append: ' announcement-bar--one-announcement'
        endif
      endif
    -%}
    <div
      class="{{ announcement_classes }}"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
      {% if position != blank %}style="justify-content: {{ position }};"{% endif %}
      {{ content_block.shopify_attributes }}
    >
      {%- if content_block.settings.text != blank -%}
        {%- if content_block.settings.link != blank -%}
          <a
            href="{{ content_block.settings.link }}"
            class="announcement-bar__link link link--text focus-inset animate-arrow"
          >
        {%- endif -%}
        <p class="announcement-bar__message h5">
          <span>{{ content_block.settings.text | escape }}</span>
          {%- if content_block.settings.link != blank -%}
            {% render 'icon-arrow' %}
          {%- endif -%}
        </p>
        {%- if content_block.settings.link != blank -%}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- elsif content_block.type == 'info' -%}
    <div
      class="announcement-bar info-container"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
      {% if position != blank %}style="justify-content: {{ position }};"{% endif %}
      {{ content_block.shopify_attributes }}
    >
      <ul>
        {%- if content_block.settings.ubicacion != blank -%}
          <li>
            {%- if content_block.settings.ubicacion_url != blank -%}
              <a href="{{ content_block.settings.ubicacion_url }}">
            {%- endif -%}
            {%- if content_block.settings.ubicacion_img != blank -%}
              <img
                width="21"
                height="21"
                loading="lazy"
                src="{{ content_block.settings.ubicacion_img | img_url: 'master' }}"
              >
            {%- endif -%}
            <span>{{ content_block.settings.ubicacion }}</span>
            {%- if content_block.settings.ubicacion_url != blank -%}</a>{%- endif -%}
          </li>
        {%- endif -%}

        {%- if content_block.settings.contacto != blank -%}
          <li>
            {%- if content_block.settings.contacto_url != blank -%}
              <a href="{{ content_block.settings.contacto_url }}">
            {%- endif -%}
            {%- if content_block.settings.contacto_img -%}
              <img
                width="21"
                height="21"
                loading="lazy"
                src="{{ content_block.settings.contacto_img | img_url: 'master' }}"
              >
            {%- endif -%}
            <span>{{ content_block.settings.contacto }}</span>
            {%- if content_block.settings.contacto_url != blank -%}</a>{%- endif -%}
          </li>
        {%- endif -%}

        {%- if content_block.settings.envio != blank -%}
          <li>
            {%- if content_block.settings.envio_url != blank -%}
              <a href="{{ content_block.settings.envio_url }}">
            {%- endif -%}
            {%- if content_block.settings.envio_img -%}
              <img
                width="21"
                height="21"
                loading="lazy"
                src="{{ content_block.settings.envio_img | img_url: 'master' }}"
              >
            {%- endif -%}
            <span>{{ content_block.settings.envio }}</span>
            {%- if content_block.settings.envio_url != blank -%}</a>{%- endif -%}
          </li>
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}
