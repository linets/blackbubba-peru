{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
  assign content_blocks_count = 0
  assign brand_buttons_count = 0
  assign first_content_block = blank
  for block in section.blocks
    if block.type == 'announcement' or block.type == 'info'
      assign content_blocks_count = content_blocks_count | plus: 1
      if first_content_block == blank
        assign first_content_block = block
      endif
    elsif block.type == 'brand_button' and block.settings.brand_image != blank
      assign brand_buttons_count = brand_buttons_count | plus: 1
    endif
  endfor
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="{% unless brand_buttons_count > 0 %}page-width {% endunless %}utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}{% if first_content_block != blank and first_content_block.type == 'info' %} info-container-head{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    <div class="announcement-bar-layout{% if brand_buttons_count > 0 %} announcement-bar-layout--with-brands{% endif %}">
      {%- if brand_buttons_count > 0 -%}
        <div class="announcement-brand-buttons" role="navigation" aria-label="Marcas">
          {%- for block in section.blocks -%}
            {%- if block.type == 'brand_button' and block.settings.brand_image != blank -%}
              {%- liquid
                assign brand_btn_class = 'announcement-brand-button'
                assign brand_image_alt = block.settings.brand_image.alt | default: 'Marca' | escape
                assign brand_image_url = block.settings.brand_image | image_url: width: 220
                assign brand_scale = block.settings.brand_scale | default: 100 | times: 0.01
                assign brand_logo_desktop_width = block.settings.brand_image.aspect_ratio | times: 14 | times: brand_scale | round
                assign brand_logo_mobile_width = block.settings.brand_image.aspect_ratio | times: 12 | times: brand_scale | round
                if block.settings.brand_active
                  assign brand_btn_class = brand_btn_class | append: ' announcement-brand-button--active'
                endif
              -%}
              {%- capture brand_image_html -%}
                <span
                  class="announcement-brand-button__image"
                  style="--brand-logo-image: url('{{ brand_image_url }}'); --brand-logo-desktop-width: {{ brand_logo_desktop_width }}px; --brand-logo-mobile-width: {{ brand_logo_mobile_width }}px;"
                  aria-hidden="true"
                ></span>
              {%- endcapture -%}
              {%- if block.settings.brand_url != blank -%}
                <a
                  class="{{ brand_btn_class }}"
                  href="{{ block.settings.brand_url }}"
                  aria-label="{{ brand_image_alt }}"
                  {% if block.settings.brand_active %}aria-current="true"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ brand_image_html }}
                </a>
              {%- else -%}
                <span
                  class="{{ brand_btn_class }}"
                  aria-label="{{ brand_image_alt }}"
                  {% if block.settings.brand_active %}aria-current="true"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ brand_image_html }}
                </span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="announcement-content">
    {%- if content_blocks_count == 1 and first_content_block != blank -%}
      {% render 'announcement-bar-content-block',
        block: first_content_block,
        single_view: true,
        show_one_announcement: section.settings.show_social,
        position: first_content_block.settings.position
      %}
    {%- elsif content_blocks_count > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-caret' %}
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              {%- unless block.type == 'announcement' or block.type == 'info' -%}
                {%- continue -%}
              {%- endunless -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                {% render 'announcement-bar-content-block', block: block %}
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-caret' %}
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
      </div>
    </div>
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <noscript class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryMobileFormNoScript', class: 'localization-form' -%}
            <div class="localization-form__select">
              <h2 class="visually-hidden" id="AnnouncementCountryMobileLabelNoScript">
                {{ 'localization.country_label' | t }}
              </h2>
              <select
                class="localization-selector link"
                name="country_code"
                aria-labelledby="AnnouncementCountryMobileLabelNoScript"
              >
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {%- if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }}
                    {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon-caret' %}
            </div>
            <button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
          {%- endform -%}
        </noscript>

        <localization-form class="small-hide medium-hide no-js-hidden">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <noscript class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageMobileFormNoScript', class: 'localization-form' -%}
            <div class="localization-form__select">
              <h2 class="visually-hidden" id="AnnouncementLanguageMobileLabelNoScript">
                {{ 'localization.language_label' | t }}
              </h2>
              <select
                class="localization-selector link"
                name="locale_code"
                aria-labelledby="AnnouncementLanguageMobileLabelNoScript"
              >
                {%- for language in localization.available_languages -%}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {%- if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon-caret' %}
            </div>
            <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
          {%- endform -%}
        </noscript>

        <localization-form class="small-hide medium-hide no-js-hidden">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .announcement-bar-layout {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    position: relative;
  }

  .announcement-bar-layout--with-brands {
    align-items: stretch;
    align-self: stretch;
    min-height: 100%;
    --brand-buttons-width: 0px;
  }

  .announcement-bar-layout .announcement-content {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    position: relative;
    z-index: 1;
  }

  .announcement-content .announcement-bar {
    margin: 0 auto;
  }

  .announcement-brand-buttons {
    display: flex;
    align-items: stretch;
    gap: {{ section.settings.brand_buttons_gap }}px;
    justify-content: flex-start;
    flex: 0 0 auto;
    box-sizing: border-box;
    height: 100%;
    min-height: 3.8rem;
    align-self: stretch;
    position: relative;
    z-index: 2;
  }

  .announcement-brand-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 0.35rem;
    margin: 0;
    border: none;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    box-sizing: border-box;
    align-self: stretch;
    height: 100%;
    min-height: 3.8rem;
    border-bottom: 3px solid transparent;
    transition: border-bottom-color 0.2s ease;
  }

  .announcement-brand-button + .announcement-brand-button {
    position: relative;
  }

  .announcement-brand-button + .announcement-brand-button::before {
    content: '';
    position: absolute;
    left: calc({{ section.settings.brand_buttons_gap }}px / -2);
    top: 25%;
    bottom: 25%;
    width: 1px;
    background-color: {{ section.settings.brand_buttons_separator_color }};
    pointer-events: none;
  }

  .announcement-brand-button--active {
    border-bottom-color: {{ section.settings.brand_buttons_separator_color }};
  }

  .announcement-brand-button:not(.announcement-brand-button--active):hover,
  .announcement-brand-button:not(.announcement-brand-button--active):focus-visible {
    border-bottom-color: {{ section.settings.brand_buttons_separator_color }};
  }

  .announcement-brand-button__image {
    display: block;
    width: var(--brand-logo-desktop-width, 110px);
    height: 14px;
    background-color: {{ section.settings.brand_buttons_logo_color }};
    mask-image: var(--brand-logo-image);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-image: var(--brand-logo-image);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
  }

  .announcement-bar-section .utility-bar .utility-bar__grid:not(.page-width) {
    padding: 0 2rem;
  }

  @media screen and (min-width: 990px) {
    .announcement-bar-layout--with-brands:not(.announcement-bar-layout--info-active) .announcement-content {
      transform: translateX(calc(var(--brand-buttons-width) / -2));
    }

    .announcement-bar-layout--with-brands.announcement-bar-layout--info-active .announcement-content {
      transform: none;
    }

    .announcement-bar-layout--with-brands.announcement-bar-layout--info-active .slider-button {
      opacity: 0;
      pointer-events: none;
    }

    .announcement-bar-layout--with-brands .announcement-bar-slider {
      width: fit-content;
      max-width: 100%;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
    }

    .announcement-bar-layout--with-brands .announcement-bar-slider .slider {
      width: auto;
      max-width: 100%;
      margin: 0;
    }

    .announcement-bar-layout--with-brands .announcement-bar-slider .slider-button--prev,
    .announcement-bar-layout--with-brands .announcement-bar-slider .slider-button--next {
      margin: 0;
      min-width: 2.8rem;
    }
  }

  @media screen and (max-width: 750px) {
    .announcement-bar-section .utility-bar .utility-bar__grid:not(.page-width) {
      padding-left: max(1.2rem, env(safe-area-inset-left, 0px));
      padding-right: max(1.2rem, env(safe-area-inset-right, 0px));
    }

    .announcement-brand-button + .announcement-brand-button::before {
      display: none;
    }

    .announcement-bar-layout--with-brands .announcement-brand-buttons {
      padding: 0 !important;
    }

    .announcement-bar-layout {
      gap: 0.5rem;
    }

    .announcement-bar-layout--with-brands {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .announcement-bar-layout--with-brands .announcement-brand-buttons {
      width: 100%;
      max-width: none;
      flex: 0 0 100%;
      justify-content: center;
      align-self: stretch;
      box-sizing: border-box;
      align-items: stretch;
      min-height: 3.8rem;
      height: auto;
      padding-inline: 1rem;
    }

    .announcement-bar-layout--with-brands .announcement-content {
      width: 100%;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
    }

    .announcement-brand-buttons {
      width: 100%;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
      min-height: 3.8rem;
      justify-content: center;
      flex-wrap: nowrap;
    }
    .announcement-brand-buttons::-webkit-scrollbar {
      display: none;
    }

    .announcement-brand-button {
      width: 50%;
      min-width: 50%;
      max-width: 50%;
      padding: 0 0.6rem;
      align-self: stretch;
      min-height: 3.8rem;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .announcement-brand-button__image {
      height: 12px;
      width: var(--brand-logo-mobile-width, 80px);
    }
  }
</style>

<script>
  (function () {
    var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionRoot) return;

    var announcementLayout = sectionRoot.querySelector('.announcement-bar-layout--with-brands');
    if (!announcementLayout) return;

    var brandButtons = announcementLayout.querySelector('.announcement-brand-buttons');
    if (brandButtons) {
      var updateBrandButtonsWidth = function () {
        announcementLayout.style.setProperty('--brand-buttons-width', brandButtons.offsetWidth + 'px');
      };
      updateBrandButtonsWidth();
      if (window.ResizeObserver) {
        new ResizeObserver(updateBrandButtonsWidth).observe(brandButtons);
      } else {
        window.addEventListener('resize', updateBrandButtonsWidth);
      }
    }

    var desktopSlider = sectionRoot.querySelector('#Slider-{{ section.id }}');

    var syncInfoState = function () {
      if (!desktopSlider) {
        announcementLayout.classList.remove('announcement-bar-layout--info-active');
        return;
      }
      var activeSlide =
        desktopSlider.querySelector(".slider__slide[aria-hidden='false']") || desktopSlider.querySelector('.slider__slide');
      var isInfoActive = Boolean(activeSlide && activeSlide.querySelector('.announcement-bar.info-container'));
      announcementLayout.classList.toggle('announcement-bar-layout--info-active', isInfoActive);
    };

    if (desktopSlider && window.MutationObserver) {
      new MutationObserver(syncInfoState).observe(desktopSlider, {
        subtree: true,
        attributes: true,
        attributeFilter: ['aria-hidden', 'class'],
      });
    }

    syncInfoState();
  })();
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "range",
      "id": "brand_buttons_gap",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Espacio entre botones de marca",
      "default": 20
    },
    {
      "type": "color",
      "id": "brand_buttons_logo_color",
      "label": "Color de logos",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "brand_buttons_separator_color",
      "label": "Color separador entre botones de marca",
      "default": "#C9C9C9"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "end",
          "label": "Posición de contenido"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    },
    {
      "type": "brand_button",
      "name": "Botón marca",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Imagen"
        },
        {
          "type": "url",
          "id": "brand_url",
          "label": "URL"
        },
        {
          "type": "checkbox",
          "id": "brand_active",
          "default": false,
          "label": "Marca activa",
          "info": "Muestra una línea negra debajo del logo (estado seleccionado)."
        },
        {
          "type": "range",
          "id": "brand_scale",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Escala del logo",
          "default": 100,
          "info": "Ajusta el tamaño relativo de este logo (100% = tamaño base)."
        }
      ]
    },
    {
      "type": "info",
      "name": "Info",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "end",
          "label": "Posición de contenido"
        },
        {
          "type": "image_picker",
          "id": "ubicacion_img",
          "label": "Ubicacion Image"
        },
        {
          "type": "text",
          "id": "ubicacion",
          "label": "Ubicacion"
        },
        {
          "type": "url",
          "id": "ubicacion_url",
          "label": "Ubicacion URL"
        },
        {
          "type": "image_picker",
          "id": "contacto_img",
          "label": "Contacto Image"
        },
        {
          "type": "text",
          "id": "contacto",
          "label": "Contacto"
        },
        {
          "type": "url",
          "id": "contacto_url",
          "label": "Contacto URL"
        },
        {
          "type": "image_picker",
          "id": "envio_img",
          "label": "Envio Image"
